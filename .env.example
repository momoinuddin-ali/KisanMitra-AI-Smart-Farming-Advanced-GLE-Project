# ─────────────────────────────────────────────────────────────
#  KisanMitra AI — environment template
#  Copy this file to .env and fill in your own keys:
#      cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── OPTION A: xAI Grok (free $25 signup credits — https://console.x.ai) ──
GROK_API_KEY=xai-your-free-api-key-here
GROK_MODEL=grok-3-mini
GROK_VISION_MODEL=grok-2-vision-1212
GROK_BASE_URL=https://api.x.ai/v1

# ── OPTION B: Z.ai API (genuinely FREE models — https://z.ai) ──
# text: glm-4.5-flash ($0) · vision: glm-4.6v-flash ($0)
# Comment out Option A and use these instead:
# GROK_API_KEY=your-z-ai-api-key
# GROK_MODEL=glm-4.5-flash
# GROK_VISION_MODEL=glm-4.6v-flash
# GROK_BASE_URL=https://api.z.ai/api/paas/v4

# Open-Meteo (free, no key needed — keep the defaults)
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# App settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
CACHE_TTL_MINUTES=30
REQUEST_TIMEOUT_SECONDS=15
FORECAST_DAYS=7